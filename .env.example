# AgentVault environment template. Copy to .env and fill in real values:
#   cp .env.example .env
# NEVER commit .env (it is gitignored) and never share the keys in it.
# ARB_SEPOLIA_RPC: Arbitrum Sepolia JSON-RPC endpoint used by deploy + agent.
ARB_SEPOLIA_RPC=
# DEPLOYER_ADDRESS + PRIVATE_KEY: the deployer (becomes the vault owner).
DEPLOYER_ADDRESS=
PRIVATE_KEY=
# AGENT_ADDRESS + AGENT_PRIVATE_KEY: the agent hot key (spending only, inside
# policy). This must be a DIFFERENT key from the deployer/owner key.
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
# SERVICE_ADDRESS: demo recipient allowlisted by the deploy script.
SERVICE_ADDRESS=
# VAULT_ADDRESS: appended/updated by script/deploy.sh after a successful
# deploy. Leave empty before the first deploy.
VAULT_ADDRESS=
